    "/v1/stores/{store_id}/incidents": {
      "get": {
        "tags": [
          "store_inventory"
        ],
        "summary": "store incidents in a time window",
        "operationId": "listStoreIncidents",
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^DS-[A-Z]{3}-\\d{2}$",
              "examples": [
                "DS-BLR-01"
              ],
              "title": "Store Id"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "rfc 3339, inclusive",
              "title": "Since"
            },
            "description": "rfc 3339, inclusive"
          },
          {
            "name": "until",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "rfc 3339, exclusive; at most 7 days after since",
              "title": "Until"
            },
            "description": "rfc 3339, exclusive; at most 7 days after since"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentsResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
