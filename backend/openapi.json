  "components": {
    "schemas": {
      "Capture": {
        "properties": {
          "capture_id": {
            "type": "string",
            "title": "Capture Id"
          },
          "amount_paise": {
            "type": "integer",
            "title": "Amount Paise",
            "description": "money in integer paise (1 rupee = 100 paise)"
          },
          "gateway_ref": {
            "type": "string",
            "title": "Gateway Ref"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Captured At"
          }
        },
        "type": "object",
        "required": [
          "capture_id",
          "amount_paise",
          "gateway_ref",
          "captured_at"
        ],
        "title": "Capture"
      },
      "GatewayEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "debit_success",
              "debit_failed",
              "capture",
              "reversal"
            ],
            "title": "Type"
          },
          "amount_paise": {
            "type": "integer",
            "title": "Amount Paise",
            "description": "money in integer paise (1 rupee = 100 paise)"
          },
          "gateway_ref": {
            "type": "string",
            "title": "Gateway Ref"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "type",
          "amount_paise",
          "gateway_ref",
          "at"
        ],
        "title": "GatewayEvent"
      },
      "GpsPoint": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "at",
          "lat",
          "lng"
        ],
        "title": "GpsPoint"
      },
      "Incident": {
        "properties": {
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "out_of_stock",
              "damaged_stock",
              "power_cut",
              "staff_shortage"
            ],
            "title": "Type"
          },
          "sku": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sku"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "incident_id",
          "type",
          "sku",
          "description",
          "at"
        ],
        "title": "Incident"
      },
      "IncidentsResponse": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id",
            "description": "ev_ + the first 32 hex characters of the sha-256 of the body without this field"
          },
          "store_id": {
            "type": "string",
            "title": "Store Id"
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "title": "Since"
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "title": "Until"
          },
          "incidents": {
            "items": {
              "$ref": "#/components/schemas/Incident"
            },
            "type": "array",
            "title": "Incidents"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "store_id",
          "since",
          "until",
          "incidents"
        ],
        "title": "IncidentsResponse"
      },
      "MissingScan": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "line_no": {
            "type": "integer",
            "title": "Line No"
          },
          "expected": {
            "type": "string",
            "enum": [
              "picked",
              "packed"
            ],
            "title": "Expected"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "line_no",
          "expected"
        ],
        "title": "MissingScan"
      },
      "OrderHistoryResponse": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id",
            "description": "ev_ + the first 32 hex characters of the sha-256 of the body without this field"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "orders": {
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            },
            "type": "array",
            "title": "Orders"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "customer_id",
          "orders"
        ],
        "title": "OrderHistoryResponse"
      },
      "OrderLine": {
        "properties": {
          "line_no": {
            "type": "integer",
            "title": "Line No"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "qty": {
            "type": "integer",
            "title": "Qty"
          },
          "unit_paise": {
            "type": "integer",
            "title": "Unit Paise",
            "description": "money in integer paise (1 rupee = 100 paise)"
          },
          "status": {
            "type": "string",
            "enum": [
              "ORDERED",
              "UNAVAILABLE",
              "SUBSTITUTED"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "line_no",
          "sku",
          "name",
          "qty",
          "unit_paise",
          "status"
        ],
        "title": "OrderLine"
      },
      "OrderResponse": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id",
            "description": "ev_ + the first 32 hex characters of the sha-256 of the body without this field"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "store_id": {
            "type": "string",
            "title": "Store Id"
          },
          "address_id": {
            "type": "string",
            "title": "Address Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "PLACED",
              "CONFIRMED",
              "PACKING",
              "PACKED",
              "OUT_FOR_DELIVERY",
              "DELIVERED",
              "CANCELLED",
              "PARTIALLY_FULFILLED"
            ],
            "title": "Status"
          },
          "item_total_paise": {
            "type": "integer",
            "title": "Item Total Paise",
            "description": "money in integer paise (1 rupee = 100 paise)"
          },
          "discount_paise": {
            "type": "integer",
            "title": "Discount Paise",
            "description": "money in integer paise (1 rupee = 100 paise)"
          },
          "delivery_fee_paise": {
            "type": "integer",
            "title": "Delivery Fee Paise",
            "description": "money in integer paise (1 rupee = 100 paise)"
          },
          "total_paise": {
            "type": "integer",
            "title": "Total Paise",
            "description": "money in integer paise (1 rupee = 100 paise)"
          },
          "coupon_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coupon Code"
          },
          "placed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Placed At"
          },
          "promised_by": {
            "type": "string",
            "format": "date-time",
            "title": "Promised By"
          },
          "delivered_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delivered At"
          },
          "cancelled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancelled At"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "type": "array",
            "title": "Lines"
          },
