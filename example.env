# copy to .env and change the passwords. never commit .env.

# postgres in docker compose (5433 on the host, so it does not clash with a local postgres on 5432).
# 127.0.0.1, not localhost: on windows localhost tries ipv6 first and waits 20 s per connection.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=hivemind_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=hivemind

# login roles made by `hm-db migrate`
# hm_backend: the simulated business; cannot read the agent or truth schemas
# hm_agent: hivemind itself; only its own agent schema
# hm_eval: the grader; reads everything, including truth
HM_BACKEND_PASSWORD=change-me-backend
HM_AGENT_PASSWORD=change-me-agent
HM_EVAL_PASSWORD=change-me-eval
