# copy to .env and change the passwords. never commit .env.

# postgres in docker compose (5433 on the host, so it does not clash with a local postgres on 5432).
# 127.0.0.1, not localhost: on windows localhost tries ipv6 first and waits 20 s per connection.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=hivemind_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=hivemind

# login roles made by `hm-db migrate`
# hm_backend: the simulated business; cannot read the agent or truth schemas
# hm_agent: hivemind itself; only its own agent schema
# hm_eval: the grader; reads everything, including truth
HM_BACKEND_PASSWORD=change-me-backend
HM_AGENT_PASSWORD=change-me-agent
HM_EVAL_PASSWORD=change-me-eval

# signing keys, 32+ characters each. make fresh ones with `uv run hm-agents new-keys` and paste the lines here.
# HM_SESSION_SECRET: the fake sign-in signs session tokens with it; hivemind checks them.
# HM_CASE_TOKEN_SECRET: hivemind signs its case tokens with it; the backend checks them.
HM_SESSION_SECRET=change-me-to-a-long-random-value-1
HM_CASE_TOKEN_SECRET=change-me-to-a-long-random-value-2

# the scenario panel's key (http://127.0.0.1:5173/panel asks for it): it shows what hivemind found on each case, the
# risk check included, so it is kept from customers. 32+ characters; `uv run hm-agents new-keys` makes one too.
# left empty, the panel is off.
HM_PANEL_KEY=

# google ai studio key for the free gemini models (https://aistudio.google.com/apikey). only made-up data is sent.
GEMINI_API_KEY=

# groq key for its free plan (https://console.groq.com/keys): the case lead, the reconciler on several-issue cases,
# and the evaluation's simulated customer and baseline run on it
GROQ_API_KEY=

# where the chat service finds the backend, and where traces go (phoenix in docker compose; `off` to switch off)
HM_BACKEND_URL=http://127.0.0.1:8080
HM_TRACES_ENDPOINT=http://127.0.0.1:6006/v1/traces
